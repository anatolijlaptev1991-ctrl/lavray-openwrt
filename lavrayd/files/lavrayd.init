#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
#
# lavrayd — procd-служба ядра LAVRay (спецификация §3.2).
# Шлюз tproxy: правила ip rule/route и таблицу inet lavray ставит ядро,
# когда инстанс в режиме шлюза стал Ready; этот скрипт готовит окружение
# и передаёт флаги из UCI.

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load lavray
	local enabled listen tls port ipv6 dns wd mark lan memlimit gogc
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get listen main listen
	config_get_bool tls main tls 1
	config_get port main tproxy_port 7893
	config_get_bool ipv6 main ipv6 0
	config_get_bool dns main dns_hijack 0
	config_get wd main watchdog_min 5
	config_get mark main fwmark 1
	config_get lan main lan br-lan
	config_get memlimit main gomemlimit 96MiB
	config_get gogc main gogc 50

	mkdir -p /var/run/lavray/active /etc/lavray/data

	# Политика маршрутизации для tproxy: помеченные пакеты доставляются
	# на локальный сокет ядра (таблица 100). Значения по умолчанию
	# совпадают с --gateway-fwmark; конфликтные фичи (mwan3, pbr)
	# разрешаются через UCI (спецификация §3.4).
	ip rule add fwmark "$mark" lookup 100 priority 100 2>/dev/null
	ip route add local 0.0.0.0/0 dev lo table 100 2>/dev/null
	[ "$ipv6" = 1 ] && {
		ip -6 rule add fwmark "$mark" lookup 100 priority 100 2>/dev/null
		ip -6 route add local ::/0 dev lo table 100 2>/dev/null
	}
	# Запоминаем mark: stop_service должен снять правило с ТЕМ mark,
	# с которым стартовали (пользователь мог сменить fwmark в UCI).
	echo "$mark" > /var/run/lavray/fwmark

	procd_open_instance
	procd_set_param command /usr/bin/lavray-core serve \
		--listen-socket unix:///var/run/lavray/core.sock \
		--token-file /etc/lavray/core.token \
		--data /etc/lavray/data --headless \
		--web-bind "$listen" --web-allow-remote \
		--platform openwrt --gateway-tproxy-port "$port" \
		--gateway-watchdog-min "$wd" --gateway-fwmark "$mark" \
		--gateway-lan "$lan" --gateway-user lavray --gateway-state-dir /var/run/lavray
	[ "$tls" = 1 ] && procd_append_param command --web-tls
	[ "$ipv6" = 1 ] && procd_append_param command --gateway-ipv6
	[ "$dns" = 1 ] && procd_append_param command --gateway-dns-hijack
	procd_set_param env GOMEMLIMIT="$memlimit" GOGC="$gogc"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Падение или остановка ядра не должны оставлять LAN без интернета:
	# снять осиротевшие правила и пометки маршрутизации (спецификация §3.2).
	nft delete table inet lavray 2>/dev/null
	rm -f /var/run/lavray/active/*.nft
	local mark="$(cat /var/run/lavray/fwmark 2>/dev/null || echo 1)"
	ip rule del fwmark "$mark" lookup 100 priority 100 2>/dev/null
	ip route flush table 100 2>/dev/null
	if [ "$(uci -q get lavray.main.ipv6)" = "1" ]; then
		ip -6 rule del fwmark "$mark" lookup 100 priority 100 2>/dev/null
		ip -6 route flush table 100 2>/dev/null
	fi
	rm -f /var/run/lavray/fwmark
}

# Хук rc.common срабатывает только при ОСТАНОВКЕ службы (после procd_kill):
# pidof уже пуст, снимаем последствия. При краше инстанса procd перезапускает
# ядро сам, а при исчерпании respawn правила за минуту снимает cron-страж
# (спецификация §3.5) — service_stopped при падении не вызывается.
service_stopped() {
	/usr/sbin/lavray-guard
}

service_triggers() {
	procd_add_reload_trigger lavray
}
