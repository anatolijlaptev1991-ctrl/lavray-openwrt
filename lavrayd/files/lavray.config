# /etc/config/lavray — конфигурация службы lavrayd (спецификация §3.2).

config lavray 'main'
	option enabled '0'
	option listen '192.168.1.1:9090'
	option tls '1'
	option tproxy_port '7893'
	option ipv6 '0'
	option dns_hijack '0'
	option watchdog_min '5'
	option fwmark '1'
	option lan 'br-lan'
	option gomemlimit '96MiB'
	option gogc '50'
